# Copy to .env. Never commit your real credentials.
# With these unset, the app starts in visibly labelled offline-demo mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gemma-4-E4B-it
GEARMATE_MODE=auto
# auto = proxy only when BOTH API settings exist, otherwise offline demo.
# live = require BOTH API settings; fail clearly rather than silently simulate.
GEARMATE_MAX_STEPS=5


# Enable only for the hosted public demo (single process, in-memory budgets).
GEARMATE_PUBLIC_DEMO=false
